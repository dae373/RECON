<Window x:Class="Recon.App.DesktopIconProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RECON 바탕화면 아이콘 진단"
        Width="900"
        Height="620"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        Loaded="Window_Loaded">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 제목 -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock
                    Text="바탕화면 아이콘 좌표 진단"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="#171A21"/>

                <TextBlock
                    x:Name="StatusText"
                    Margin="0,6,0,0"
                    Text="아이콘 목록을 읽는 중입니다."
                    FontSize="13"
                    Foreground="#656B76"/>

                <TextBlock
                    x:Name="HandleText"
                    Margin="0,4,0,0"
                    FontSize="11"
                    Foreground="#8B9099"/>

            </StackPanel>

            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                Width="100"
                Height="36"
                Content="다시 읽기"
                Click="RefreshButton_Click"/>

        </Grid>

        <!-- 아이콘 목록 -->
        <Border
            Grid.Row="2"
            Background="White"
            BorderBrush="#DCE0E7"
            BorderThickness="1"
            CornerRadius="8">

            <DataGrid
                x:Name="IconGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                RowHeaderWidth="0"
                AlternatingRowBackground="#F8F9FB"
                BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="#"
                        Width="50"
                        Binding="{Binding Index}"/>

                    <DataGridTextColumn
                        Header="아이콘 이름"
                        Width="260"
                        Binding="{Binding Name}"/>

                    <DataGridTextColumn
                        Header="X"
                        Width="90"
                        Binding="{Binding X}"/>

                    <DataGridTextColumn
                        Header="Y"
                        Width="90"
                        Binding="{Binding Y}"/>

                    <DataGridTextColumn
                        Header="너비"
                        Width="90"
                        Binding="{Binding Width}"/>

                    <DataGridTextColumn
                        Header="높이"
                        Width="90"
                        Binding="{Binding Height}"/>

                    <DataGridCheckBoxColumn
                        Header="화면 밖"
                        Width="80"
                        Binding="{Binding IsOffscreen}"/>

                    <DataGridTextColumn
                        Header="Automation ID"
                        Width="180"
                        Binding="{Binding AutomationId}"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- 하단 버튼 -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="테스트 아이콘 하나만 이동 후 즉시 원래 위치로 복구합니다."
                FontSize="12"
                Foreground="#777D88"
                VerticalAlignment="Center"/>

            <Button
                x:Name="RoundTripTestButton"
                Grid.Column="1"
                Width="150"
                Height="38"
                Margin="0,0,8,0"
                Content="이동·복원 테스트"
                Click="RoundTripTestButton_Click"/>

            <Button
                Grid.Column="2"
                Width="90"
                Height="38"
                Content="닫기"
                Click="CloseButton_Click"/>

        </Grid>

    </Grid>

</Window>
