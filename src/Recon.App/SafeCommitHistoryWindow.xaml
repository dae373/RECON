<Window x:Class="Recon.App.SafeCommitHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RECON 분석 기록"
        Width="1100"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        Loaded="Window_Loaded">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="Safe Commit 분석 기록"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#171A21"/>

                <TextBlock
                    x:Name="StatusText"
                    Margin="0,6,0,0"
                    Text="기록을 불러오는 중입니다."
                    FontSize="13"
                    Foreground="#656B76"/>

            </StackPanel>

            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                Width="100"
                Height="36"
                Content="새로고침"
                Click="RefreshButton_Click"/>

        </Grid>

        <!-- 기록 목록 -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE0E7"
                BorderThickness="1"
                CornerRadius="8">

            <DataGrid x:Name="HistoryGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="#F8F9FB"
                      BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="생성 시간"
                        Width="150"
                        Binding="{Binding CreatedAt}"/>

                    <DataGridTextColumn
                        Header="커밋 ID"
                        Width="210"
                        Binding="{Binding CommitId}"/>

                    <DataGridTextColumn
                        Header="이름"
                        Width="180"
                        Binding="{Binding CommitName}"/>

                    <DataGridTextColumn
                        Header="상태"
                        Width="120"
                        Binding="{Binding Status}"/>

                    <DataGridTextColumn
                        Header="검증"
                        Width="90"
                        Binding="{Binding CanExecute}"/>

                    <DataGridTextColumn
                        Header="승인"
                        Width="70"
                        Binding="{Binding ApprovedCount}"/>

                    <DataGridTextColumn
                        Header="제외"
                        Width="70"
                        Binding="{Binding ExcludedCount}"/>

                    <DataGridTextColumn
                        Header="오류"
                        Width="70"
                        Binding="{Binding ErrorCount}"/>

                    <DataGridTextColumn
                        Header="분석 폴더"
                        Width="280"
                        Binding="{Binding SourceFolder}"/>

                    <DataGridTextColumn
                        Header="JSON 위치"
                        Width="340"
                        Binding="{Binding FilePath}"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- 하단 -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="저장된 파일 분석 및 안전 검증 기록을 확인할 수 있습니다."
                FontSize="12"
                Foreground="#777D88"
                VerticalAlignment="Center"/>

            <Button
                Grid.Column="1"
                Width="130"
                Height="38"
                Margin="0,0,8,0"
                Content="저장 폴더 열기"
                Click="OpenFolderButton_Click"/>

            <Button
                Grid.Column="2"
                Width="90"
                Height="38"
                Content="닫기"
                Click="CloseButton_Click"/>

        </Grid>

    </Grid>

</Window>
