<Window x:Class="Recon.App.MovePreflightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RECON 이동 전 검증"
        Width="1150"
        Height="680"
        MinWidth="850"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 제목과 요약 -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="이동 전 안전 검증"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#171A21"/>

                <TextBlock Margin="0,6,0,0"
                           Text="승인된 파일의 충돌, 위험도 및 사용 상태를 확인했습니다."
                           FontSize="13"
                           Foreground="#656B76"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Border Margin="0,0,8,0"
                        Padding="14,9"
                        Background="#E8F7ED"
                        BorderBrush="#A8DDB8"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="이동 가능 "
                                   Foreground="#287A41"/>

                        <TextBlock x:Name="ReadyCountText"
                                   FontWeight="Bold"
                                   Foreground="#186632"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,8,0"
                        Padding="14,9"
                        Background="#F1F2F5"
                        BorderBrush="#D4D7DD"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="사용자 제외 "
                                   Foreground="#666C77"/>

                        <TextBlock x:Name="ExcludedCountText"
                                   FontWeight="Bold"
                                   Foreground="#454A53"/>
                    </StackPanel>
                </Border>

                <Border Padding="14,9"
                        Background="#FDECEC"
                        BorderBrush="#F0B8B8"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="안전 차단 "
                                   Foreground="#AF3232"/>

                        <TextBlock x:Name="BlockedCountText"
                                   FontWeight="Bold"
                                   Foreground="#942222"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 파일별 검증 결과 -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE0E7"
                BorderThickness="1"
                CornerRadius="8">

            <DataGrid x:Name="PreflightGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="#F8F9FB"
                      BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="상태"
                        Width="100"
                        Binding="{Binding Status}"/>

                    <DataGridTextColumn
                        Header="ID"
                        Width="80"
                        Binding="{Binding FileId}"/>

                    <DataGridTextColumn
                        Header="파일명"
                        Width="180"
                        Binding="{Binding FileName}"/>

                    <DataGridTextColumn
                        Header="검증 결과"
                        Width="280"
                        Binding="{Binding Reason}"/>

                    <DataGridTextColumn
                        Header="원래 위치"
                        Width="320"
                        Binding="{Binding OriginalPath}"/>

                    <DataGridTextColumn
                        Header="이동 예정 위치"
                        Width="320"
                        Binding="{Binding PlannedPath}"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 하단 버튼 -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="안전 차단 파일은 Safe Commit에 기록되지만 이동 대상에서는 제외됩니다."
                FontSize="12"
                Foreground="#777D88"
                VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Width="110"
                    Height="38"
                    Margin="0,0,8,0"
                    Content="돌아가기"
                    Click="BackButton_Click"/>

            <Button Grid.Column="2"
                    Width="150"
                    Height="38"
                    Content="Safe Commit 저장"
                    Background="#246BFD"
                    Foreground="White"
                    BorderBrush="#246BFD"
                    Click="ContinueButton_Click"/>
        </Grid>

    </Grid>
</Window>
