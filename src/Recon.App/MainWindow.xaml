<Window x:Class="Recon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RECON"
        Width="640"
        Height="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        Topmost="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="BorderBrush"
                    Value="#D8DCE3"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">

            <Setter Property="Background"
                    Value="#246BFD"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#246BFD"/>

        </Style>

    </Window.Resources>

    <Border Background="#F8F9FC"
            BorderBrush="#D8DCE3"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">

        <Border.Effect>
            <DropShadowEffect
                Color="#55000000"
                BlurRadius="24"
                ShadowDepth="6"
                Opacity="0.35"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 상단 영역 -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown=
                      "Header_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="34"
                            Height="34"
                            Background="#246BFD"
                            CornerRadius="8">

                        <TextBlock Text="R"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="12,0,0,0">

                        <TextBlock Text="RECON"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#171A21"/>

                        <TextBlock
                            Text="Find · Organize · Restore"
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="#777D89"/>

                    </StackPanel>

                </StackPanel>

                <Button Grid.Column="1"
                        Width="34"
                        Height="34"
                        Content="✕"
                        FontSize="14"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>

            </Grid>

            <!-- 검색 및 명령 입력 -->
            <Border Grid.Row="2"
                    Height="52"
                    Padding="16,0"
                    Background="White"
                    BorderBrush="#CCD2DC"
                    BorderThickness="1"
                    CornerRadius="10">

                <DockPanel>

                    <TextBlock Text="⌕"
                               Margin="0,0,12,0"
                               FontSize="23"
                               Foreground="#737A87"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             Foreground="#20242C"
                             VerticalContentAlignment="Center"
                             ToolTip="파일명, 위치 또는 명령 검색"/>

                </DockPanel>

            </Border>

            <!-- 안내 영역 -->
            <Border Grid.Row="4"
                    Padding="20"
                    Background="White"
                    BorderBrush="#E0E3E9"
                    BorderThickness="1"
                    CornerRadius="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <Border Width="38"
                                Height="38"
                                Background="#EAF1FF"
                                CornerRadius="19">

                            <TextBlock Text="✓"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#246BFD"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="14,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock
                                Text="안전한 파일 정리 계획을 확인하세요"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#282D36"/>

                            <TextBlock
                                Margin="0,4,0,0"
                                Text="분석 결과를 검토하고 안전한 정리 계획을 저장합니다."
                                FontSize="12"
                                Foreground="#7A808B"/>

                        </StackPanel>

                    </StackPanel>

                    <Border Grid.Row="2"
                            Padding="12"
                            Background="#F7F8FA"
                            CornerRadius="8">

                        <TextBlock
                            Text="폴더 스캔 → 파일 분류 → 위험도 검사 → 계획 검토 → Safe Commit"
                            FontSize="12"
                            Foreground="#626976"
                            TextWrapping="Wrap"/>

                    </Border>

                </Grid>

            </Border>

            <!-- 하단 버튼 -->
            <Grid Grid.Row="6">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="분석 시작"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OrganizeButton_Click"/>

                <Button Grid.Column="1"
                        Content="기록"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="HistoryButton_Click"/>

                <Button Grid.Column="2"
                        Content="아이콘 진단"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="IconDiagnosticButton_Click"/>

                <TextBlock Grid.Column="3"
                           Text="ESC로 닫기"
                           Foreground="#9297A1"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

            </Grid>

        </Grid>

    </Border>

</Window>
