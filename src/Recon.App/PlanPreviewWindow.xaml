<Window x:Class="Recon.App.PlanPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RECON 정리 계획"
        Width="1200"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 및 요약 -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="정리 계획 미리보기"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#171A21"/>

                <TextBlock Margin="0,6,0,0"
                           Text="파일을 이동하기 전에 분류 결과와 위험도를 검토하세요."
                           FontSize="13"
                           Foreground="#656B76"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Border Margin="0,0,8,0"
                        Padding="14,9"
                        Background="White"
                        BorderBrush="#DCE0E7"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="전체 "
                                   Foreground="#656B76"/>

                        <TextBlock x:Name="TotalCountText"
                                   FontWeight="Bold"
                                   Foreground="#20242C"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,8,0"
                        Padding="14,9"
                        Background="#EAF1FF"
                        BorderBrush="#B8CDFE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="사전 승인 "
                                   Foreground="#3868C7"/>

                        <TextBlock x:Name="ApprovedCountText"
                                   FontWeight="Bold"
                                   Foreground="#2457B8"/>
                    </StackPanel>
                </Border>

                <Border Padding="14,9"
                        Background="#FFF3E4"
                        BorderBrush="#F4C987"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="검토 필요 "
                                   Foreground="#A56718"/>

                        <TextBlock x:Name="ReviewCountText"
                                   FontWeight="Bold"
                                   Foreground="#8D540C"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 폴더 및 오류 정보 -->
        <Border Grid.Row="2"
                Padding="14"
                Background="White"
                BorderBrush="#DCE0E7"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="분석한 폴더"
                               FontSize="11"
                               Foreground="#858B95"/>

                    <TextBlock x:Name="SourceFolderText"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#252A33"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="36,0,0,0">
                    <TextBlock Text="추천 정리 위치"
                               FontSize="11"
                               Foreground="#858B95"/>

                    <TextBlock x:Name="DestinationFolderText"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#252A33"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="36,0,0,0">
                    <TextBlock Text="제외 / 오류"
                               FontSize="11"
                               Foreground="#858B95"/>

                    <TextBlock x:Name="ErrorSummaryText"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#A25A14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 정리 계획 표 -->
        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#DCE0E7"
                BorderThickness="1"
                CornerRadius="8">

            <DataGrid x:Name="PlanGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="#F8F9FB"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <DataGridCheckBoxColumn
                        Header="승인"
                        Width="60"
                        Binding="{Binding IsApproved,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn
                        Header="ID"
                        Width="80"
                        IsReadOnly="True"
                        Binding="{Binding FileId}"/>

                    <DataGridTextColumn
                        Header="파일명"
                        Width="180"
                        IsReadOnly="True"
                        Binding="{Binding FileName}"/>

                    <DataGridTextColumn
                        Header="카테고리"
                        Width="140"
                        IsReadOnly="True"
                        Binding="{Binding Category}"/>

                    <DataGridTextColumn
                        Header="신뢰도"
                        Width="80"
                        IsReadOnly="True"
                        Binding="{Binding Confidence}"/>

                    <DataGridTextColumn
                        Header="위험도"
                        Width="80"
                        IsReadOnly="True"
                        Binding="{Binding MoveRisk}"/>

                    <DataGridTextColumn
                        Header="분류 이유"
                        Width="250"
                        IsReadOnly="True"
                        Binding="{Binding Reason}"/>

                    <DataGridTextColumn
                        Header="원래 위치"
                        Width="300"
                        IsReadOnly="True"
                        Binding="{Binding OriginalPath}"/>

                    <DataGridTextColumn
                        Header="이동 예정 위치"
                        Width="300"
                        IsReadOnly="True"
                        Binding="{Binding SuggestedPath}"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 하단 영역 -->
        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="현재 단계에서는 검토 결과만 생성하며 실제 파일은 이동하지 않습니다."
                Foreground="#777D88"
                FontSize="12"
                VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Width="110"
                    Height="38"
                    Margin="0,0,8,0"
                    Content="취소"
                    Click="CancelButton_Click"/>

            <Button Grid.Column="2"
                    Width="140"
                    Height="38"
                    Content="검토 완료"
                    Background="#246BFD"
                    Foreground="White"
                    BorderBrush="#246BFD"
                    Click="ConfirmButton_Click"/>
        </Grid>

    </Grid>
</Window>
